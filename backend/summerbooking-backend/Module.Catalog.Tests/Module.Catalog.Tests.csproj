<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- Il job di retention delle foto parla con un PostgreSQL vero: il suo perimetro e' SQL - una
         finestra, due join e una sottoquery su un altro schema - e un doppio proverebbe solo che il
         doppio funziona. Questa e' anche l'UNICA verifica possibile oggi, perche' il legacy non ha
         mai avuto gli abbonamenti (Q10) e sui dati migrati la cessazione non e' calcolabile. -->
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj" />
    <ProjectReference Include="..\Module.Catalog\Module.Catalog.csproj" />
  </ItemGroup>

</Project>
