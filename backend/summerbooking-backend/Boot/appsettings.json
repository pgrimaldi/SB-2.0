{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "_nota": "Durate e parametri di autenticazione. Nessun segreto qui: chiavi, pepper e credenziali social arrivano dal secret manager.",
    "AccessTokenMinutes": 10080,
    "RefreshTokenDays": 30,
    "RefreshTokenRememberMeDays": 90,
    "ExternalTokenMinutes": 60,
    "SignedPartnerTokenHours": 24,
    "TeamSystemTokenDays": 7,
    "OtpChallengeMinutes": 10,
    "OtpDigits": 6,
    "OtpMaxAttempts": 5,
    "PasswordResetMinutes": 60,
    "LockoutThreshold": 5,
    "LockoutMinutes": 15,
    "ImpersonationTicketSeconds": 60,
    "ImpersonationSessionMinutes": 60,
    "PartnerSignatureToleranceSeconds": 300,
    "TermsVersion": "2026-01",
    "AllowedOrigins": [],
    "FrontendUrls": {
      "hub": "",
      "customer": "",
      "admin": ""
    },
    "RefreshCookie": {
      "Name": "__Secure-sb_rt",
      "Path": "/api/identity",
      "Secure": true
    },
    "RateLimit": {
      "PermitPerMinute": 20
    },
    "PasswordHash": {
      "MemoryKiB": 19456,
      "Iterations": 2,
      "Parallelism": 1
    },
    "Social": {
      "GoogleClientIds": [],
      "AppleClientIds": [],
      "FacebookAppId": ""
    }
  },
  "Jwt": {
    "_nota": "Issuer diverso per ambiente (qui produzione): un token emesso in un ambiente non vale negli altri. Gli altri ambienti lo sovrascrivono.",
    "Issuer": "summerbooking-identity-prod",
    "UserAudience": "summerbooking-app",
    "ApiAudience": "summerbooking-external-api",
    "ClockSkewSeconds": 30
  },
  "Identity": {
    "Documents": {
      "Region": "us-east-2",
      "Origin": "s3_us_east_2",
      "KeyPrefix": "contracts/",
      "DownloadUrlMinutes": 15
    },
    "CommonPasswords": {
      "_nota": "Elenco delle password diffuse rifiutate alla scelta di una nuova password. Aggiornato da un job mensile notturno; se il file manca vale la copia incorporata nel modulo.",
      "RefreshEnabled": true,
      "FilePath": "data/identity/common-passwords.txt",
      "DayOfMonth": 1,
      "Hour": 3,
      "TimeZone": "Europe/Rome"
    }
  },
  "Notification": {
    "Smtp": {
      "Port": 587,
      "EnableSsl": true,
      "FromAddress": "noreply@summerbooking.it",
      "FromName": "Summer Booking"
    },
    "Outbound": {
      "_nota": "Chi puo' ricevere i messaggi di questo ambiente. Live (tutti) e' ammesso solo in Production; gli altri ambienti usano Off o Allowlist con AllowedRecipients.",
      "Mode": "Live"
    }
  }
}