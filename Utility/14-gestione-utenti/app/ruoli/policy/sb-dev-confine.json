{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TuttoTranneIdentitaEAccount",
      "Effect": "Allow",
      "NotAction": ["iam:*", "organizations:*", "account:*"],
      "Resource": "*"
    },
    {
      "Sid": "LetturaIam",
      "Effect": "Allow",
      "Action": ["iam:Get*", "iam:List*"],
      "Resource": "*"
    },
    {
      "Sid": "SoloRuoliSbDev",
      "Effect": "Allow",
      "Action": ["iam:PassRole"],
      "Resource": "arn:aws:iam::{{Account}}:role/sb-dev-*"
    },
    {
      "Sid": "RuoliDiServizio",
      "Effect": "Allow",
      "Action": ["iam:CreateServiceLinkedRole"],
      "Resource": "*"
    }
  ]
}
