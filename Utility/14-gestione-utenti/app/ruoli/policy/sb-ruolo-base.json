{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ProprioUtente",
      "Effect": "Allow",
      "Action": [
        "iam:GetUser", "iam:ChangePassword", "iam:GetLoginProfile",
        "iam:ListAccessKeys", "iam:CreateAccessKey", "iam:UpdateAccessKey", "iam:DeleteAccessKey",
        "iam:GetAccessKeyLastUsed", "iam:ListGroupsForUser", "iam:ListUserTags",
        "iam:ListMFADevices", "iam:EnableMFADevice", "iam:ResyncMFADevice",
        "iam:SimulatePrincipalPolicy"
      ],
      "Resource": "arn:aws:iam::{{Account}}:user/${aws:username}"
    },
    {
      "Sid": "ProprioMfaVirtuale",
      "Effect": "Allow",
      "Action": ["iam:CreateVirtualMFADevice"],
      "Resource": "arn:aws:iam::{{Account}}:mfa/*"
    },
    {
      "Sid": "LetturaPerLaConsole",
      "Effect": "Allow",
      "Action": ["iam:GetAccountPasswordPolicy", "iam:GetAccountSummary", "iam:ListVirtualMFADevices", "sts:GetCallerIdentity"],
      "Resource": "*"
    }
  ]
}
