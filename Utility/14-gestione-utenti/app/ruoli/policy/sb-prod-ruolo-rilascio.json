{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AggiornamentoStack",
      "Effect": "Allow",
      "Action": [
        "cloudformation:UpdateStack", "cloudformation:DescribeStacks", "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResource", "cloudformation:DescribeStackResources",
        "cloudformation:GetTemplate", "cloudformation:GetTemplateSummary",
        "cloudformation:CancelUpdateStack", "cloudformation:ContinueUpdateRollback"
      ],
      "Resource": "arn:aws:cloudformation:{{Region}}:{{Account}}:stack/{{Stack}}/*"
    },
    {
      "Sid": "TaskDefinition",
      "Effect": "Allow",
      "Action": ["ecs:RegisterTaskDefinition", "ecs:DeregisterTaskDefinition", "ecs:DescribeTaskDefinition", "ecs:ListTaskDefinitions"],
      "Resource": "*"
    },
    {
      "Sid": "ServizioWeb",
      "Effect": "Allow",
      "Action": ["ecs:UpdateService", "ecs:DescribeServices", "ecs:TagResource"],
      "Resource": [
        "arn:aws:ecs:{{Region}}:{{Account}}:service/{{Output:ClusterName}}/*",
        "arn:aws:ecs:{{Region}}:{{Account}}:task-definition/*"
      ]
    },
    {
      "Sid": "RuoliDeiTask",
      "Effect": "Allow",
      "Action": ["iam:PassRole"],
      "Resource": ["{{Output:TaskRoleArn}}", "{{Output:TaskExecutionRoleArn}}"],
      "Condition": {"StringEquals": {"iam:PassedToService": "ecs-tasks.amazonaws.com"}}
    },
    {
      "Sid": "LetturePerCloudFormation",
      "Effect": "Allow",
      "Action": ["iam:GetRole", "ecr:DescribeRepositories", "logs:DescribeLogGroups", "ec2:DescribeSubnets", "ec2:DescribeSecurityGroups", "ec2:DescribeVpcs"],
      "Resource": "*"
    }
  ]
}
