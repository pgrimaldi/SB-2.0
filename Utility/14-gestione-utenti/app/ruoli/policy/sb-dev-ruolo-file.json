{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FileApplicativi",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:AbortMultipartUpload"],
      "Resource": ["arn:aws:s3:::{{Output:FilesBucketName}}", "arn:aws:s3:::{{Output:FilesBucketName}}/*"]
    },
    {
      "Sid": "ArchivioDellaRetentionInLettura",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetObject"],
      "Resource": ["arn:aws:s3:::{{Output:ArchiveBucketName}}", "arn:aws:s3:::{{Output:ArchiveBucketName}}/*"]
    },
    {
      "Sid": "AltriBucketInLettura",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::{{Output:FrontendBucketName}}", "arn:aws:s3:::{{Output:FrontendBucketName}}/*",
        "arn:aws:s3:::{{Output:BuildBucketName}}", "arn:aws:s3:::{{Output:BuildBucketName}}/*"
      ]
    }
  ]
}
