  "home": {
    "page": {
      "title": "برنامج إدارة المنتجعات الشاطئية: جرّب Summer Booking Hub",
      "description": "برنامج سحابي لإدارة المنتجعات الشاطئية لزيادة المبيعات والأرباح دون تكاليف خفية."
    },
    "hero": {
      "title": "رؤية، ظهور، تحكّم.",
      "description": "مع Summer Booking Hub، منصة الإدارة من الجيل الجديد، تنطلق بمنتجعك الشاطئي نحو آفاق جديدة.",
      "image": {
        "alt": "منارة تطل على شاطئ مجهّز بالمظلات"
      }
    },
    "management": {
      "title": "Beach Management System",
      "description": "ليست مجرد أداة، بل منصة إدارة سحابية من الجيل الجديد تبسّط العمل وتوفر الوقت والموارد لتساعدك على النمو والتطور.",
      "cards": {
        "all": {
          "title": "الكل في واحد",
          "intro": "حجوزات عبر الإنترنت وخارجه، خريطة تفاعلية، قوائم أسعار وباقات وخدمات إضافية: أدِر كل شيء من مكان واحد.",
          "detail": "ملف العميل، عروض أسعار مخصصة وتسويق مصمم لك."
        },
        "agility": {
          "title": "أقصى مرونة تشغيلية",
          "intro": "ادخل من أي مكان وأي جهاز، حتى مع أبسط اتصال. سحابة آمنة ونسخ احتياطي وتحديثات تلقائية.",
          "detail": "إعداد سريع وتدريب أسرع: تبدأ العمل فورًا وبشكل كامل."
        },
        "control": {
          "title": "تحكم دقيق",
          "intro": "تقارير وإحصاءات فورية لمتابعة المبيعات والتكاليف والإيرادات وسير الموسم.",
          "detail": "أدِر الأسعار والأدوار والمخزن والموظفين بأعلى كفاءة."
        }
      }
    },
    "shift": {
      "title": "غيّر الإيقاع",
      "cards": {
        "reserve": {
          "title": "+30% حجوزات",
          "intro": "من الإنترنت إلى الشاطئ. بفضل سهولة الحجز والعروض والخصومات الموجّهة زاد عملاؤنا حجوزاتهم حتى 30% سنويًا.",
          "detail": "هل تريد أنت أيضًا نموًا برقمين؟"
        },
        "explode": {
          "title": "+30,000 حجز عبر الإنترنت",
          "intro": "غطِّ كل القنوات عبر الإنترنت: من بوابة وتطبيق Summer Booking إلى موقعك وInstagram وFacebook.",
